
model Subscription {
    id Int @id() @default(autoincrement())
    name String @default("STARTER")
    maxUserCount Int
    storage Int
    price Int
    tenant Tenant[]
    features Feature[]
}

enum Feature {
    DASHBOARD
    TENANT
    USER
    PROJECT
    OFFER
    CLIENT
    ROLE
    INVOICE
    PROSPECTION
    TIMESHEET
    ALERTE
}