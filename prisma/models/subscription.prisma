
model Subscription {
    id Int @id() @default(autoincrement())
    type SubscriptionType @default(STARTER)
    maxUserCount Int
    storage Int
    price Int
    tenant Tenant[]
    features Feature[]
}

enum SubscriptionType {
    STARTER
    PRO
    ENTERPRISE
}

enum Feature {
    DASHBOARD
    TENANT
    USER
    PROJECT
    OFFER
    CLIENT
    ROLE
    INVOICE
    PROSPECTION
    TIMESHEET
    ALERTE
}