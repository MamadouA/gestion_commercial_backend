model User {
  id        Int      @id @default(autoincrement())
  fullname  String
  email     String   @unique
  phone     String
  role Role[]
  isActive  Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  Int
  createdAt DateTime @default(now())
}

enum Role {
  SUPERADMIN
}