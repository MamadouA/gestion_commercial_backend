model User {
  id        Int      @id @default(autoincrement())
  fullname  String
  email     String   @unique
  password String
  phone     String
  roles Role[]
  isActive  Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  Int
  prospections Prospection[] // prospection created by the user
  comments Comment[] // comment made by the user
  createdAt DateTime @default(now())
}

enum Role {
  SUPERADMIN
  COMMERCIAL
}