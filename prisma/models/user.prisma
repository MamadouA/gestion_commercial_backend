model User {
  id        Int      @id @default(autoincrement())
  fullname  String
  email     String   @unique
  password String
  phone     String
  roles Role[]
  isActive  Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  Int
  prospections Prospection[] // prospection created by the user
  comments Comment[] // comment made by the user
  invoices Invoice[] // invoice created by this user
  journalEvents JournalEvent[] // project events

  createdOffers Offer[] @relation("offerAuthor") // offers created by the user
  createdAt DateTime @default(now())
}

enum Role {
  SUPERADMIN
  ADMIN
  DIRECTEUR_GENERAL
  ASSISTANT
  COMMERCIAL
  INGENIEUR
  CHEF_DE_CHANTIER
  CONDUCTEUR_DE_TRAVAUX
  INGENIEUR_BUREAU_ETUDES
  DIRECTEUR_COMMERCIAL
  REPRESENTANT_COMMERCIAL
  RESPONSABLE_LOGISTIQUE
}

