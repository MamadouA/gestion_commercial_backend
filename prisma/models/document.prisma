
model Document {
    id Int @id @default(autoincrement())
    description String?
    originalName String
    storedName String @unique()
    size Decimal
    mimetype String
    createdAt DateTime @default(now())

    prospectionId Int?
    prospection Prospection? @relation(fields: [prospectionId], references: [id])

    offerId Int?
    offer Offer? @relation(fields: [offerId], references: [id])

    projectId Int?
    project Project? @relation(fields: [projectId], references: [id])

    journalEventId Int? @unique()
    journalEvents JournalEvent? @relation(fields: [journalEventId], references: [id])

    invoice Invoice?
}