
model Document {
    id Int @id @default(autoincrement())
    description String?
    originalName String
    storedName String @unique()
    size Decimal
    mimetype String
    createdAt DateTime @default(now())

    prospectionId Int?
    prospection Prospection? @relation(fields: [prospectionId], references: [id], onDelete: Cascade)

    offerId Int?
    offer Offer? @relation(fields: [offerId], references: [id], onDelete: Cascade)

    projectId Int?
    project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

    invoice Invoice?
    report Report?
}