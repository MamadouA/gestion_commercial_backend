
model Client {
    id Int @id @default(autoincrement())
    type ClientType 
    country String
    address String
    contactName String
    phone String
    email String
    enterpriseName String?
    enterpriseLegalForm EnterpriseLegalForm?
    mainActivity String?
    createdAt DateTime @default(now())

    tenantId Int 
    tenant Tenant @relation(fields: [tenantId], references: [id])
    prospections Prospection[]

    offers Offer[]
    projects Project[]
}

enum ClientType {
    PARTICULIER
    ENTREPRISE
}

enum EnterpriseLegalForm {
    Person
    SARL
    SA
    SAS
    SUARL
    SNC
    SCS
}